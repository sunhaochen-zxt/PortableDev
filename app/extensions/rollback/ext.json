{
  "schema": 1,
  "name": "rollback",
  "version": "0.0.1",
  "title": "Rollback",
  "priority": 40,
  "entry": "index.js",
  "interpreter": "node",
  "requiresKernel": ">=1",
  "requires": ["log.audit", "storage.*"],
  "provides": [
    {
      "name": "rollback.run",
      "version": 1,
      "mutates": true
    }
  ],
  "commands": [
    {
      "name": "rollback",
      "summary": "undo a task from the audit stream",
      "usage": "pd rollback --task <任务号> [--dry-run]",
      "mutates": true,
      "parallel": false
    }
  ],
  "lifecycle": {
    "start": "on-demand",
    "startTimeout": "5s",
    "heartbeatTimeout": "60s",
    "stopTimeout": "3s",
    "restart": "on-crash",
    "maxRestarts": 3
  }
}
