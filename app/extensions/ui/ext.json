{
  "schema": 1,
  "name": "ui",
  "version": "0.0.1",
  "title": "PortableDev UI",
  "priority": 100,
  "entry": "index.js",
  "interpreter": "node",
  "requiresKernel": ">=1",
  "permissions": [
    { "kind": "ui", "allow": true },
    { "kind": "commands", "allow": ["list", "search", "fetch", "install", "remove", "upgrade", "log", "version", "config"] }
  ],
  "pages": [
    { "id": "overview", "title": "概览", "entry": "ui/overview.html", "icon": "home", "order": 10, "nav": "sidebar" },
    { "id": "packages", "title": "软件包", "entry": "ui/packages.html", "icon": "box", "order": 20, "nav": "sidebar" },
    { "id": "logs", "title": "日志", "entry": "ui/logs.html", "icon": "list", "order": 30, "nav": "sidebar" }
  ],
  "lifecycle": { "start": "on-demand", "startTimeout": "5s", "heartbeatTimeout": "60s", "stopTimeout": "3s", "restart": "on-crash", "maxRestarts": 1 }
}
