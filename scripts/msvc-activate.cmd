@echo off
REM ---------------------------------------------------------------------------
REM  Activate the portable MSVC toolchain (cl.exe + Windows SDK) in this shell.
REM
REM    call "E:\PortableDev\scripts\msvc-activate.cmd"
REM
REM  Plain C/C++ work does not need this script: PortableDev apply already puts
REM  cl.exe on PATH and INCLUDE/LIB in the environment. Call it before
REM  `flutter build windows`, which additionally needs the four Visual Studio
REM  variables below.
REM
REM  Everything is derived from this file's own location, so the stick can move
REM  to another drive letter without editing anything.
REM ---------------------------------------------------------------------------

if defined MSVC_ACTIVATED (
  echo [msvc] already active: %VCToolsVersion% / SDK %WindowsSDKVersion%
  exit /b 0
)

set "MSVC_ROOT=%~dp0..\tools\msvc"
for %%i in ("%MSVC_ROOT%") do set "MSVC_ROOT=%%~fi"

if not exist "%MSVC_ROOT%\setup.cmd" (
  echo [ERR] "%MSVC_ROOT%\setup.cmd" not found - the toolset was not generated by msvc-kit.
  exit /b 1
)
if not exist "%MSVC_ROOT%\pf86\Microsoft Visual Studio\Installer\vswhere.exe" (
  echo [ERR] vswhere shim missing under "%MSVC_ROOT%\pf86" - Flutter will not find the toolchain.
  exit /b 1
)

REM setup.cmd is generated by `msvc-kit setup --script --portable-root`, exports
REM INCLUDE, LIB, PATH, VCToolsInstallDir, WindowsSdkDir and WindowsSDKVersion.
call "%MSVC_ROOT%\setup.cmd" || exit /b 2

REM ---------------------------------------------------------------------------
REM  Make CMake accept an instance the Visual Studio Installer never heard of.
REM
REM  cmVSSetupHelper.cxx: IsEWDKEnabled() is true when both EnterpriseWDK and
REM  DisableRegistryUse are "True"; that branch takes VSINSTALLDIR and
REM  VisualStudioVersion straight from the environment. This is the same path an
REM  Enterprise WDK build uses - no registry, no COM, no vswhere.
REM ---------------------------------------------------------------------------
set "EnterpriseWDK=True"
set "DisableRegistryUse=True"
set "VSINSTALLDIR=%MSVC_ROOT%"
set "VisualStudioVersion=17.14.35207.0"

REM Flutter's visual_studio.dart hard codes
REM   %ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe
REM so pointing the variable at the stick makes it find our shim (which prints
REM this instance as JSON). CMake's own lookup honours the same variable.
set "ProgramFiles(x86)=%MSVC_ROOT%\pf86"

REM ---------------------------------------------------------------------------
REM  Keep MSBuild from fighting the environment.
REM
REM  UseEnv=true makes the C++ targets take INCLUDE/LIB from the environment
REM  instead of querying the registry for the Windows SDK (otherwise the link
REM  step cannot find kernel32.lib, then MSVCRTD.lib).
REM
REM  CheckMSVCComponents=false skips MSB8052, the toolset/platform check that
REM  refuses MSVC 14.4x because this MSBuild is 17.3. Same v143 ABI, verified by
REM  a real `flutter build windows --release`.
REM ---------------------------------------------------------------------------
set "UseEnv=true"
set "CheckMSVCComponents=false"

set "MSVC_ACTIVATED=1"
exit /b 0
