<UserControl x:Class="PortableDev.Gui.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <!-- ================================ Headline card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,9,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BadBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Pending}" Value="无（已同步）">
                                                <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding Subline}" Foreground="{StaticResource TextDimBrush}"
                                   Margin="18,7,0,0" TextWrapping="Wrap" MaxWidth="560"
                                   HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Margin="18,14,0,0">
                            <TextBlock Text="待应用：" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Pending}" Style="{StaticResource Value}"
                                       Foreground="{StaticResource WarnBrush}" />
                            <TextBlock Text="   ·   工具：" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding ToolSummary}" Style="{StaticResource Value}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="刷新" Style="{StaticResource FlatButton}"
                                Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                        <Button Content="立即应用" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ApplyCommand}"
                                IsEnabled="{Binding CanApply}"
                                ToolTip="调用 PortableDev.cmd apply，会先备份再写入" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================ Two columns -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.05*" />
                </Grid.ColumnDefinitions>

                <!-- Left: key facts -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="位置" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="U 盘根目录" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding StickRoot}" Style="{StaticResource Value}"
                                       Margin="0,2,0,0" ToolTip="{Binding StickRoot}" />
                            <TextBlock Text="{Binding StickMeta}" Style="{StaticResource Muted}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14" />

                            <TextBlock Text="稳定根（PATH 里写的就是它）" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding StableRoot}" Style="{StaticResource Value}"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding JunctionGlyph}" Margin="0,0,6,0"
                                           Foreground="{StaticResource WarnBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding JunctionOk}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Junction}" Style="{StaticResource Muted}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="计数" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PATH" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding PathCount}" Style="{StaticResource Value}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="环境变量" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding EnvCount}" Style="{StaticResource Value}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="快捷操作" Style="{StaticResource SectionTitle}" />
                            <Button Content="逐项验证工具（verify）" Style="{StaticResource FlatButton}"
                                    HorizontalAlignment="Stretch" Command="{Binding VerifyCommand}" />
                            <Button Content="查看变更预览" Style="{StaticResource FlatButton}"
                                    HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                    Command="{Binding DataContext.NavCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="2" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: state rows -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="本机状态" Style="{StaticResource SectionTitle}"
                                   Margin="16,16,16,8" />
                        <ListBox ItemsSource="{Binding Rows}" Style="{StaticResource PlainListBox}"
                                 ItemContainerStyle="{StaticResource PlainListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RowBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="Auto" MinWidth="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Mark}"
                                                       FontWeight="Bold" FontSize="11"
                                                       VerticalAlignment="Top" Margin="0,1,0,0"
                                                       Foreground="{Binding Ok, Converter={StaticResource BoolToBrush}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       VerticalAlignment="Top" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                       TextWrapping="Wrap" VerticalAlignment="Top" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
