<UserControl x:Class="PortableDev.Gui.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Value}" />
                    <TextBlock Text="{Binding Current}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding UpdateSummary}" Style="{StaticResource Muted}" Margin="0,2,0,0"
                               Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="刷新" Style="{StaticResource FlatButton}" Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}" />
                    <Button Content="新增工具" Style="{StaticResource FlatButton}" Margin="0,0,8,0"
                            Command="{Binding AddToolCommand}"
                            ToolTip="生成 manifest.d&lt;id&gt;.toml" />
                    <Button Content="检查更新" Style="{StaticResource FlatButton}" Margin="0,0,8,0"
                            Command="{Binding CheckUpdatesCommand}"
                            ToolTip="向上游查询每个工具的最新版本（只读，不下载）" />
                    <Button Content="全部验证" Style="{StaticResource PrimaryButton}"
                            Command="{Binding VerifyAllCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar DockPanel.Dock="Top" Style="{StaticResource ThinProgress}"
                     Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,0,0,10"
                     Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />

        <!-- Column header -->
        <Border DockPanel.Dock="Top" Padding="12,0,12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.55*" />
                    <ColumnDefinition Width="Auto" MinWidth="76" />
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="Auto" MinWidth="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="工具" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="2" Text="版本" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="3" Text="状态" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="4" Text="位置" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="5" Text="操作" Style="{StaticResource Muted}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <ListBox ItemsSource="{Binding Rows}" Style="{StaticResource PlainListBox}"
                     ItemContainerStyle="{StaticResource PlainListItem}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="0.55*" />
                                    <ColumnDefinition Width="Auto" MinWidth="76" />
                                    <ColumnDefinition Width="1.7*" />
                                    <ColumnDefinition Width="Auto" MinWidth="120" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Ok, Converter={StaticResource BoolToBrush}}" />

                                <!-- DockPanel, not a horizontal StackPanel: only a width-constrained
                                     parent makes TextTrimming actually clip before the version column. -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="3" Padding="5,0" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource BadSoftBrush}"
                                                Visibility="{Binding Missing, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="未安装" FontSize="10.5"
                                                       Foreground="{StaticResource BadBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Notes}" Style="{StaticResource Muted}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Reason}" FontSize="10.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource BadBrush}"
                                               ToolTip="{Binding Output}"
                                               Visibility="{Binding HasReason, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Version}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextDimBrush}" />
                                    <TextBlock Text="{Binding UpdateText}" FontSize="10.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource AccentBrush}"
                                               Visibility="{Binding CheckedUpstream, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <Border Grid.Column="3" CornerRadius="4" Padding="7,2" VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Background="{Binding Ok, Converter={StaticResource BoolToSoftBrush}}">
                                    <TextBlock Text="{Binding Status}" FontSize="11.5"
                                               Foreground="{Binding Ok, Converter={StaticResource BoolToBrush}}" />
                                </Border>

                                <TextBlock Grid.Column="4" Text="{Binding Path}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource TextFaintBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip="{Binding Path}" />

                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="升级" Style="{StaticResource PrimaryButton}" Padding="9,3"
                                            FontSize="11.5" Margin="0,0,6,0"
                                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.UpgradeCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="安装" Style="{StaticResource FlatButton}" Padding="9,3"
                                            FontSize="11.5" Margin="0,0,6,0"
                                            Command="{Binding DataContext.InstallToolCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="编辑" Style="{StaticResource FlatButton}" Padding="9,3"
                                            FontSize="11.5" Margin="0,0,6,0"
                                            Command="{Binding DataContext.EditToolCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="目录" Style="{StaticResource FlatButton}" Padding="9,3"
                                            FontSize="11.5"
                                            Command="{Binding DataContext.OpenFolderCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
