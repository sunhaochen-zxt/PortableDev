<Window x:Class="PortableDev.Gui.Views.UpgradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="升级工具"
        Width="660" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" />
            <TextBlock x:Name="SubText" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="100"
                         Foreground="{StaticResource AccentBrush}"
                         Background="{StaticResource SurfaceAltBrush}"
                         Value="0" />
            <Grid Margin="0,6,0,0">
                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" />
                <TextBlock x:Name="SpeedText" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>

        <TextBox Grid.Row="2" x:Name="TxtLog" IsReadOnly="True"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                 Background="{StaticResource SurfaceBrush}"
                 Foreground="{StaticResource TextDimBrush}"
                 BorderBrush="{StaticResource BorderBrush}"
                 Padding="10" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnClose" Content="关闭" Style="{StaticResource FlatButton}" Margin="0,0,10,0"
                    IsCancel="True" Click="OnClose" />
            <Button x:Name="BtnStart" Content="开始升级" Style="{StaticResource PrimaryButton}"
                    Click="OnStart" />
        </StackPanel>
    </Grid>
</Window>
