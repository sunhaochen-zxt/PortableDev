<Window x:Class="PortableDev.Gui.Views.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装 / 更新工具"
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" />
            <TextBlock Text="把压缩包解压到 tools\&lt;id&gt;\&lt;版本&gt;。不会改 PATH —— 之后按“应用”才生效。"
                       Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="压缩包（zip / 7z / tar.gz）" Style="{StaticResource Label}" />
            <Grid Margin="0,4,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtArchive" FontFamily="{StaticResource MonoFont}" />
                <Button Grid.Column="2" Content="浏览…" Style="{StaticResource FlatButton}" Click="OnBrowse" />
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="安装为版本" Style="{StaticResource Label}" />
                    <TextBox x:Name="TxtVersion" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <CheckBox x:Name="ChkStrip" Style="{StaticResource FlatCheck}"
                              Content="自动剥离压缩包里的单一顶层目录" IsChecked="True" />
                    <CheckBox x:Name="ChkUpdateVersion" Style="{StaticResource FlatCheck}" Margin="0,6,0,0"
                              Content="成功后把清单里的版本号改成这个" IsChecked="True" />
                </StackPanel>
            </Grid>

            <TextBlock Text="日志" Style="{StaticResource Label}" Margin="0,4,0,4" />
            <TextBox x:Name="TxtLog" Height="220" IsReadOnly="True"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                     Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextDimBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     Padding="10" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="关闭" Style="{StaticResource FlatButton}" Margin="0,0,10,0"
                    IsCancel="True" Click="OnClose" />
            <Button x:Name="BtnInstall" Content="开始安装" Style="{StaticResource PrimaryButton}"
                    Click="OnInstall" />
        </StackPanel>
    </Grid>
</Window>
