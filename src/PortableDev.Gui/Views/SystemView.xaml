<UserControl x:Class="PortableDev.Gui.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <StackPanel VerticalAlignment="Center" Margin="0,0,180,0">
                    <TextBlock Text="{Binding Status}" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock Text="由盘上的 fastfetch 实时读取，内容原样显示，可选中复制"
                               Style="{StaticResource Muted}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="复制" Style="{StaticResource FlatButton}" Margin="0,0,10,0"
                            Command="{Binding CopyCommand}" />
                    <Button Content="刷新" Style="{StaticResource FlatButton}"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <TextBox Text="{Binding Report, Mode=OneWay}"
                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     BorderThickness="0" Background="Transparent"
                     Foreground="{StaticResource TextBrush}"
                     FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                     Padding="16,12" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </Border>
    </DockPanel>
</UserControl>
