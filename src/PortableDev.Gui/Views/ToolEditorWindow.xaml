<Window x:Class="PortableDev.Gui.Views.ToolEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工具清单"
        Width="620" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Add form -->
        <ScrollViewer Grid.Row="1" x:Name="FormPanel" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="工具 id（小写，用作目录名）" Style="{StaticResource Label}" />
                        <TextBox x:Name="TxtId" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="版本" Style="{StaticResource Label}" />
                        <TextBox x:Name="TxtVersion" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="显示名称" Style="{StaticResource Label}" />
                <TextBox x:Name="TxtTitle" Margin="0,4,0,10" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="类型" Style="{StaticResource Label}" />
                        <ComboBox x:Name="CmbKind" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="目录（相对 U 盘根）" Style="{StaticResource Label}" />
                        <TextBox x:Name="TxtDir" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="加到 PATH 的子目录（每行一个，. 表示工具根）" Style="{StaticResource Label}" />
                <TextBox x:Name="TxtPathDirs" Height="60" Margin="0,4,0,10"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         FontFamily="{StaticResource MonoFont}" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="校验命令" Style="{StaticResource Label}" />
                        <TextBox x:Name="TxtVerifyRun" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="期望输出包含" Style="{StaticResource Label}" />
                        <TextBox x:Name="TxtVerifyExpect" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="备注（会显示在工具列表里）" Style="{StaticResource Label}" />
                <TextBox x:Name="TxtNotes" Margin="0,4,0,10" />

                <CheckBox x:Name="ChkEnabled" Style="{StaticResource FlatCheck}" Content="启用（不启用则不进 PATH）" IsChecked="True" />
            </StackPanel>
        </ScrollViewer>

        <!-- Raw editor -->
        <TextBox Grid.Row="1" x:Name="RawPanel" Visibility="Collapsed"
                 AcceptsReturn="True" AcceptsTab="True"
                 FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="{StaticResource SurfaceBrush}"
                 Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource BorderBrush}"
                 Padding="10" />

        <!-- Error -->
        <Border Grid.Row="2" x:Name="ErrorBox" Visibility="Collapsed"
                Background="{StaticResource BadSoftBrush}" CornerRadius="6"
                Padding="12,8" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource BadBrush}"
                       FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextWrapping="Wrap" />
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="BtnDelete" Content="删除这个工具" Style="{StaticResource FlatButton}"
                    HorizontalAlignment="Left" Visibility="Collapsed"
                    Foreground="{StaticResource BadBrush}" Click="OnDelete" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource FlatButton}" Margin="0,0,10,0"
                        IsCancel="True" Click="OnCancel" />
                <Button Content="保存" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="OnSave" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
