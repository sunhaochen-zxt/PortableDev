<UserControl x:Class="PortableDev.Gui.Views.DoctorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="与 PortableDev doctor 使用同一套判断规则" Style="{StaticResource Muted}"
                               Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="重新体检" Style="{StaticResource FlatButton}" Margin="0,0,10,0"
                            Command="{Binding RunCommand}" />
                    <Button Content="卸载（clean）" Style="{StaticResource FlatButton}"
                            Command="{Binding CleanCommand}"
                            Foreground="{StaticResource BadBrush}"
                            ToolTip="只删除本程序加的东西，别人写的 PATH 条目原样保留" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <ListBox ItemsSource="{Binding Rows}" Style="{StaticResource PlainListBox}"
                     ItemContainerStyle="{StaticResource PlainListItem}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowBorder}" Padding="16,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="Auto" MinWidth="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontWeight="Bold"
                                           VerticalAlignment="Top" Margin="0,1,0,0"
                                           Foreground="{Binding Ok, Converter={StaticResource BoolToBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Top" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                           TextWrapping="Wrap" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
