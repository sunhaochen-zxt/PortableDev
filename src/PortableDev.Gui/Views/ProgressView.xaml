<UserControl x:Class="PortableDev.Gui.Views.ProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StepText}" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="复制日志" Style="{StaticResource FlatButton}" Padding="10,4"
                                Command="{Binding CopyCommand}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                <ProgressBar Style="{StaticResource ThinProgress}" Margin="0,10,0,0"
                             Maximum="{Binding StepTotal, Mode=OneWay}"
                             Value="{Binding Step, Mode=OneWay}"
                             Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="0,10,0,0"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <Border CornerRadius="6" Padding="14,10"
                    Background="{Binding Ok, Converter={StaticResource BoolToSoftBrush}}">
                <TextBlock Text="{Binding Result}" TextWrapping="Wrap"
                           Foreground="{Binding Ok, Converter={StaticResource BoolToBrush}}" />
            </Border>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <!-- Long PATH lines must wrap, not scroll: the whole point of this page is
                 reading the transcript, and a horizontal scrollbar hides most of it. -->
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="14,12">
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
