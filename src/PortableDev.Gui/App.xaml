<Application x:Class="PortableDev.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:PortableDev.Gui.Infrastructure"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <inf:BoolToVisibilityConverter x:Key="BoolToVis" />
            <inf:BoolToBrushConverter x:Key="BoolToBrush" />
            <inf:BoolToSoftBrushConverter x:Key="BoolToSoftBrush" />
            <inf:ChangeGlyphBrushConverter x:Key="ChangeBrush" />
            <inf:InverseBoolConverter x:Key="InverseBool" />
            <inf:NonEmptyToVisibilityConverter x:Key="NonEmptyVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
